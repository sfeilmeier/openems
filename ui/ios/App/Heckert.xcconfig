//

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBlobWriter" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunityFileOpener" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorFilesystem" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorIosAutofillSavePassword" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorSecureStoragePlugin" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorSplashScreen" "${PODS_CONFIGURATION_BUILD_DIR}/GCDWebServer" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftKeychainWrapper"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor/Capacitor.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp/CapacitorApp.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBlobWriter/CapacitorBlobWriter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunityFileOpener/CapacitorCommunityFileOpener.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova/Cordova.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorFilesystem/CapacitorFilesystem.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorIosAutofillSavePassword/CapacitorIosAutofillSavePassword.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorSecureStoragePlugin/CapacitorSecureStoragePlugin.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorSplashScreen/CapacitorSplashScreen.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GCDWebServer/GCDWebServer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftKeychainWrapper/SwiftKeychainWrapper.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"z" -framework "CFNetwork" -framework "Capacitor" -framework "CapacitorApp" -framework "CapacitorBlobWriter" -framework "CapacitorCommunityFileOpener" -framework "CapacitorFilesystem" -framework "CapacitorIosAutofillSavePassword" -framework "CapacitorSecureStoragePlugin" -framework "CapacitorSplashScreen" -framework "Cordova" -framework "GCDWebServer" -framework "MobileCoreServices" -framework "SwiftKeychainWrapper" -framework "WebKit"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
